{
  "name": "qword",
  "version": "1.0.0",
  "description": "English words learning app",
  "keywords": [
    "English",
    "Words",
    "Anki",
    "Study",
    "SRS"
  ],
  "license": "ISC",
  "author": "Marat Magomedov",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "test:recommendations": "node --import tsx --test tests/recommendation-schema.test.cjs",
    "test:models": "node --import tsx --test tests/recommendation-schema.test.cjs tests/model-integrity.test.cjs",
    "test:repositories": "node --import tsx --test tests/repositories.test.cjs tests/recommendation-repository.test.cjs",
    "test:algorithms": "node --import tsx --test tests/learning-algorithms.test.cjs tests/learning-services.test.cjs",
    "typecheck:recommendations": "tsc --project tsconfig.recommendations.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^1.0.0-rc.4",
    "grammy": "^1.46.0",
    "ts-fsrs": "^5.4.2"
  }
}
